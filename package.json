{
  "name": "alvinade98-laravel-blade-navigator",
  "displayName": "Ades Laravel Blade Navigator",
  "description": "Ctrl+click Laravel Blade views, including concatenated controller properties and module namespaces.",
  "version": "0.1.3",
  "publisher": "alvinade98",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:blade",
    "workspaceContains:**/*.blade.php"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test",
    "package": "vsce package --allow-missing-repository"
  },
  "contributes": {
    "commands": [
      {
        "command": "laravelBladeNavigator.scanDataTables",
        "title": "Scan DataTable yang belum sesuai standar",
        "category": "Laravel Blade Navigator",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "laravelBladeNavigator",
          "title": "DataTable Standar",
          "icon": "images/datatable.svg"
        }
      ]
    },
    "views": {
      "laravelBladeNavigator": [
        {
          "id": "laravelBladeNavigator.dataTables",
          "name": "Belum Sesuai Standar",
          "icon": "images/datatable.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "laravelBladeNavigator.dataTables",
        "contents": "Tidak ada DataTable yang menyimpang dari standar.\n[Scan DataTable](command:laravelBladeNavigator.scanDataTables)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "laravelBladeNavigator.scanDataTables",
          "when": "view == laravelBladeNavigator.dataTables",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ades Laravel Blade Navigator",
      "properties": {
        "laravelBladeNavigator.namespaces": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Custom view namespaces mapped to view directories relative to the Laravel project root. Example: {\"mahasiswa\": [\"Modules/Mahasiswa/resources/views\"]}."
        },
        "laravelBladeNavigator.dataTableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show errors/warnings when a Yajra DataTable or its controller departs from the getPageData() → with() → $this->view_path boilerplate."
        }
      }
    }
  },
  "dependencies": {
    "php-parser": "^3.7.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "icon": "images/icon.png"
}
